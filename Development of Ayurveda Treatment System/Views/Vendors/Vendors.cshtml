@model IEnumerable<Development_of_Ayurveda_Treatment_System.Models.Vendor>

@{
    ViewData["Title"] = "Vendors";
}

<main class="main">
    <div class="container mt-5">
        <h2 class="mb-4"><i class="fas fa-store me-2"></i>Our Vendors</h2>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var vendor in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@vendor.VendorName</h5>
                            <p class="card-text flex-grow-1">
                                <b>Email:</b> @vendor.Email <br />
                                <b>Address:</b> @vendor.Address <br />
                                <b>Contact No:</b> @vendor.ContactNo <br />
                                <b>Registration No:</b> @vendor.RegistrationNo <br />
                                <b>Fax No:</b> @vendor.FaxNo
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</main>
