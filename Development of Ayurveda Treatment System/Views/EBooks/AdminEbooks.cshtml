@model IEnumerable<Development_of_Ayurveda_Treatment_System.Models.EBooks>

@{
    ViewData["Title"] = "Manage EBooks";
}

<main class="main">
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-primary">
                <i class="fas fa-book me-2"></i>Manage EBooks
            </h2>
            <a href="@Url.Action("AddEbooks", "Ebooks")" class="btn btn-success" id="addEbookBtn">
                <i class="fas fa-plus me-1"></i> Add EBook
            </a>
        </div>
        

        @foreach (var book in Model)
        {
            <div class="card mb-4 shadow-sm border-0">
                <div class="row g-0 align-items-center">
                    <!-- Image Section -->
                    <div class="col-md-3">
                        <img src="@(book.BookId switch
                        {
                            "B001" => "https://via.placeholder.com/200x200?text=EBook+1",
                            "B002" => "https://via.placeholder.com/200x200?text=EBook+2",
                            "B003" => "https://via.placeholder.com/200x200?text=EBook+3",
                            _ => "https://via.placeholder.com/200x200?text=EBook"
                        })"
                             class="img-fluid rounded-start" alt="EBook Image" style="object-fit:cover; height:200px; width:100%;" />
                    </div>

                    <!-- Details Section -->
                    <div class="col-md-7">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@book.BookName</h5>
                            <p class="card-text mb-1"><strong>Author:</strong> @book.AuthorName</p>
                            <p class="card-text mb-1"><strong>Edition:</strong> @book.EditionNo</p>
                            <p class="card-text mb-0"><strong>Published:</strong> @book.DateOfPublish.ToString("dd MMM yyyy")</p>
                        </div>
                    </div>

                    <!-- Actions Section -->
                    <div class="col-md-2 text-center">
                        <div class="card-body d-flex flex-column justify-content-center align-items-center h-100">
                            <button class="btn btn-sm btn-primary mb-2 w-100"><i class="fas fa-edit me-1"></i>Edit</button>
                            <button class="btn btn-sm btn-danger w-100"><i class="fas fa-trash me-1"></i>Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</main>