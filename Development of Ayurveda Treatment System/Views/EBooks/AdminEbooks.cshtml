@model IEnumerable<Development_of_Ayurveda_Treatment_System.Models.EBooks>

@{
    ViewData["Title"] = "Manage EBooks";
}

<main class="main">
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-primary">
                <i class="fas fa-book me-2"></i>Manage EBooks
            </h2>
            <a href="@Url.Action("AddEbooks", "Ebooks")" class="btn btn-success" id="addEbookBtn">
                <i class="fas fa-plus me-1"></i> Add EBook
            </a>
        </div>
        

        @foreach (var book in Model)
        {
            <div class="card mb-4 shadow-sm border-0">
                <div class="row g-0 align-items-center">
                    <!-- Image Section -->
                    <div class="col-md-3 d-flex justify-content-center align-items-center">
                        
                        <img src="@(book.BookId switch
                            {
                                "B001" => Url.Content("~/assets/img/ebook.png"),
                                "B002" => Url.Content("~/assets/img/ebook.png"),
                                "B003" => Url.Content("~/assets/img/ebook.png"),
                                _ => Url.Content("~/assets/img/ebook.png")
                            })"
                            class="img-fluid rounded shadow-sm"
                            alt="EBook Image"
                            style="max-height:180px; max-width:150px; object-fit:contain;" />
                    </div>

                    <!-- Details Section -->
                    <div class="col-md-7">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@book.BookName</h5>
                            <p class="card-text mb-1"><strong>Author:</strong> @book.AuthorName</p>
                            <p class="card-text mb-1"><strong>Edition:</strong> @book.EditionNo</p>
                            <p class="card-text mb-0"><strong>Published:</strong> @book.DateOfPublish.ToString("dd MMM yyyy")</p>
                        </div>
                    </div>

                    <!-- Actions Section -->
                    <div class="col-md-2 text-center">
                        <div class="card-body d-flex flex-column justify-content-center align-items-center h-100">
                            <a href="javascript:void(0);"  data-bookid="@book.BookId" class="btn btn-sm btn-primary mb-2 w-100 edit-ebook-btn"><i class="fas fa-edit me-1"></i>Edit</a>
                            <a href="javascript:void(0);"  data-bookid="@book.BookId" class="btn btn-sm btn-danger w-100" id="delete-ebook-btn"><i class="fas fa-trash me-1"></i>Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</main>