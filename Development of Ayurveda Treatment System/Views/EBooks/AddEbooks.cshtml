@model Development_of_Ayurveda_Treatment_System.Models.EBooks

@{
    ViewData["Title"] = "Add EBook";
}

<main class="main">
    <div class="container mt-5">

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header text-white" style="background-color:#4da6ff;">
                <h4 class="mb-0"><i class="fas fa-book me-2"></i>Add New EBook</h4>
            </div>

            <div class="card-body">
                <form asp-action="AddEbooks" method="post" id="saveEbookForm">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <!-- Image Preview Section -->
                        

                        <!-- Details Section -->
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label asp-for="BookName" class="form-label fw-bold">Book Name</label>
                                <input asp-for="BookName" class="form-control" placeholder="Enter book name" />
                                <span asp-validation-for="BookName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="AuthorName" class="form-label fw-bold">Author Name</label>
                                <input asp-for="AuthorName" class="form-control" placeholder="Enter author name" />
                                <span asp-validation-for="AuthorName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="EditionNo" class="form-label fw-bold">Edition Number</label>
                                <input asp-for="EditionNo" class="form-control" placeholder="Enter edition number" />
                                <span asp-validation-for="EditionNo" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="DateOfPublish" class="form-label fw-bold">Date of Publish</label>
                                <input asp-for="DateOfPublish" type="date" class="form-control" />
                                <span asp-validation-for="DateOfPublish" class="text-danger"></span>
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <a asp-action="ManageEbooks" class="btn btn-secondary" id="backToDashboardBtn">
                                    <i class="fas fa-arrow-left me-1"></i> Back
                                </a>
                                <button type="submit" class="btn btn-success" id=saveEbook>
                                    <i class="fas fa-save me-1"></i> Save EBook
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</main>
