@model IEnumerable<Development_of_Ayurveda_Treatment_System.Models.Course>
@{
    ViewData["Title"] = "Course Management";
}

<main class="main">
    <div class="container py-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">
                <i class="bi bi-book-half"></i> Course Management
            </h2>
            <a href="javascript:void(0)" class="btn btn-success shadow-sm load-section-btn" data-section="AddCourse" id="btnAddCourse">
                <i class="bi bi-plus-circle me-2"></i> Add New Course
            </a>
        </div>

        <!-- Course Cards -->
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var course in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card shadow-lg border-0 h-100 rounded-4">
                            <div class="card-body d-flex flex-column">

                                <!-- Course Title -->
                                <h5 class="card-title fw-bold text-dark mb-3">
                                    <i class="bi bi-journal-text text-primary me-2"></i> @course.CourseName
                                </h5>

                                <!-- Duration & Fee -->
                                <p class="mb-2">
                                    <span class="badge bg-info text-dark me-2">
                                        ⏱ @course.CourseDuration
                                    </span>
                                    <span class="badge bg-success">
                                        💰 @course.CourseFeeStruc
                                    </span>
                                </p>

                                <!-- Benefits -->
                                <div class="mb-3">
                                    <h6 class="fw-semibold text-secondary mb-1">✨ Benefits</h6>
                                    <p class="small text-muted" style="white-space: pre-line; line-height:1.5;">
                                        @course.Benefits
                                    </p>
                                </div>

                                <!-- Institute -->
                                <div class="mb-2">
                                    <h6 class="fw-semibold text-secondary mb-1">🏫 Institute</h6>
                                    <p class="small text-muted">@course.InstituteName</p>
                                </div>

                                <!-- Address -->
                                <div class="mb-2">
                                    <h6 class="fw-semibold text-secondary mb-1">📍 Address</h6>
                                    <p class="small text-muted" style="white-space: pre-line;">
                                        @course.InstituteAddress
                                    </p>
                                </div>

                                <!-- Contact -->
                                <div class="mb-3">
                                    <h6 class="fw-semibold text-secondary mb-1">📞 Contact</h6>
                                    <p class="small text-muted">@course.InstituteContactNo</p>
                                </div>

                                <!-- Action Buttons -->
                                <div class="mt-auto d-flex justify-content-between">
                                    <a href="javascript:void(0);" class="btn btn-sm btn-warning px-3 btnEditCourse" data-id="@course.CourseId">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <a href="javascript:void(0);" 
                                       data-id="@course.CourseId" 
                                       class="btn btn-sm btn-danger px-3 btnDeleteCourse">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted">
                    <p>No courses available</p>
                </div>
            }
        </div>
    </div>
</main>