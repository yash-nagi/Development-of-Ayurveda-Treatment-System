@model Development_of_Ayurveda_Treatment_System.Models.Course

@{
    ViewData["Title"] = "Course Details";
}

<main class="main">
    <div class="container mt-5">
        <h2 class="mb-4"><i class="fas fa-book me-2"></i>@Model.CourseName</h2>

        <div class="card shadow-sm rounded-3 p-4">
            <div class="card-body">
                <h5 class="mb-3">Course Information</h5>
                <p><strong>Duration:</strong> @Model.CourseDuration</p>
                <p><strong>Fees:</strong> ₹@Model.CourseFeeStruc</p>
                <p><strong>Benefits:</strong> @Model.Benefits</p>

                <hr />

                <h5 class="mb-3">Institute Information</h5>
                <p><strong>Name:</strong> @Model.InstituteName</p>
                <p><strong>Address:</strong> @Model.InstituteAddress</p>
                <p><strong>Contact:</strong> @Model.InstituteContactNo</p>

                <div class="mt-4 text-end">
                    <a href="javascript:void(0);" class="btn btn-secondary me-2" id="backToCourses">
                        <i class="fas fa-arrow-left me-1"></i> Back to Courses
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>
