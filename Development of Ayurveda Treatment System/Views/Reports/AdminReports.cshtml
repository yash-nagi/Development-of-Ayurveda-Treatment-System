@{
    ViewData["Title"] = "User Reports";
}

<main class="main">
    <div class="container mt-4">
        <h2 class="mb-4 text-center">User Reports</h2>

        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3 mb-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center">
                        <h6>Total Users</h6>
                        <h3>150</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center">
                        <h6>Total Queries</h6>
                        <h3>320</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center">
                        <h6>Total Feedbacks</h6>
                        <h3>120</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center">
                        <h6>Reports Submitted</h6>
                        <h3>75</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- User Table -->
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                User Details & Activities
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>User Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Queries</th>
                                <th>Feedback</th>
                                <th>Reports</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>John Doe</td>
                                <td>john@example.com</td>
                                <td>User</td>
                                <td>5</td>
                                <td>2</td>
                                <td>1</td>
                            </tr>
                            <tr>
                                <td>Jane Smith</td>
                                <td>jane@example.com</td>
                                <td>Doctor</td>
                                <td>3</td>
                                <td>1</td>
                                <td>0</td>
                            </tr>
                            <tr>
                                <td>Michael Brown</td>
                                <td>michael@example.com</td>
                                <td>Vendor</td>
                                <td>2</td>
                                <td>3</td>
                                <td>2</td>
                            </tr>
                            <tr>
                                <td>Emily Johnson</td>
                                <td>emily@example.com</td>
                                <td>User</td>
                                <td>4</td>
                                <td>0</td>
                                <td>1</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Optional: Filters / Tabs for Queries, Feedback, Reports -->
        <div class="card shadow-sm mt-5">
            <div class="card-header bg-secondary text-white">
                Quick Insights
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-4 mb-3">
                        <h6>Top Query Submitters</h6>
                        <p>John Doe, Emily Johnson</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h6>Top Feedback Providers</h6>
                        <p>Michael Brown, Jane Smith</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h6>Reports Submitted</h6>
                        <p>Michael Brown, John Doe</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
