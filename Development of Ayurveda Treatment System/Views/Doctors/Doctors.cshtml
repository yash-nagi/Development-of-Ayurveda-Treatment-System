@model IEnumerable<Development_of_Ayurveda_Treatment_System.Models.Doctor>

@{
    ViewData["Title"] = "Experts";
}

<main class="main">
    <div class="container mt-5">
        <h2 class="mb-4"><i class="fas fa-user-md me-2"></i>Our Experts</h2>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }

        <div class="row g-4">
            @foreach (var doc in Model)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-3 d-flex flex-row align-items-center p-3">
                        <!-- Doctor Image -->
                        <div style="width:150px; height:150px; display:flex; align-items:center; justify-content:center; background:white; flex-shrink:0; border-radius:50%;">
                            <img src="~/assets/img/doctor.png" 
                                 class="img-fluid" 
                                 style="max-height:100%; max-width:100%; object-fit:contain;" 
                                 alt="@doc.DoctorName" />
                        </div>

                        <!-- Doctor Info -->
                        <div class="card-body d-flex flex-column ps-4">
                            <h5 class="card-title">@doc.DoctorName</h5>
                            <p class="card-text flex-grow-1 mb-2">
                                <b>Email:</b> @doc.Email <br />
                                <b>Contact:</b> @doc.ContactNo <br />
                                <b>Department:</b> @doc.Department <br />
                                <b>Consultation Fees:</b> ₹@doc.ConsultationFees <br />
                                <b>Available:</b> @doc.AppointmentDate.ToString("dd MMM yyyy") at @doc.AppointmentTime
                            </p>

                            <form asp-action="BookAppointment" method="post" class="mt-auto">
                                <input type="hidden" name="doctorId" value="@doc.DoctorId" />
                                <input type="hidden" name="appointmentDate" value="@doc.AppointmentDate" />
                                <input type="hidden" name="appointmentTime" value="@doc.AppointmentTime" />
                                <input type="hidden" name="appointmentTime" value="@doc.ConsultationFees" />
                                <button type="submit" class="btn btn-success w-25">
                                    <i class="fas fa-calendar-check me-1"></i> Book
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</main>
