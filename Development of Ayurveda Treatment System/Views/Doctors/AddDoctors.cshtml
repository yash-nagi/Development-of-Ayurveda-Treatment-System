@model Development_of_Ayurveda_Treatment_System.Models.Doctor

@{
    ViewData["Title"] = "Add Doctor";
}

<main class="main">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><i class="fas fa-user-md me-2"></i>Add Doctor</h4>
                    </div>
                    <div class="card-body p-4">
                        @using (Html.BeginForm("AddDoctor", "Doctors", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(model => model.DoctorId)

                            <div class="mb-3">
                                @Html.LabelFor(model => model.DoctorName, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(model => model.DoctorName, new { @class = "form-control", placeholder = "Enter doctor's full name" })
                                @Html.ValidationMessageFor(model => model.DoctorName, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(model => model.Email, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(model => model.Email, new { @class = "form-control", type = "email", placeholder = "Enter email" })
                                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(model => model.ContactNo, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(model => model.ContactNo, new { @class = "form-control", type = "number", placeholder = "Enter contact number" })
                                @Html.ValidationMessageFor(model => model.ContactNo, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(model => model.Department, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(model => model.Department, new { @class = "form-control", placeholder = "Enter department" })
                                @Html.ValidationMessageFor(model => model.Department, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(model => model.AppointmentID, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(model => model.AppointmentID, new { @class = "form-control", placeholder = "Enter appointment ID" })
                                @Html.ValidationMessageFor(model => model.AppointmentID, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3 row">
                                <div class="mb-3">
                                    @Html.LabelFor(m => m.AppointmentDate, new { @class = "form-label fw-bold" })
                                    @Html.TextBoxFor(m => m.AppointmentDate,
                                        new { @class = "form-control", type = "date", value = Model?.AppointmentDate.ToString("yyyy-MM-dd") })
                                    @Html.ValidationMessageFor(m => m.AppointmentDate, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-6">
                                    @Html.LabelFor(model => model.AppointmentTime, new { @class = "form-label fw-bold" })
                                    @Html.TextBoxFor(model => model.AppointmentTime, new { @class = "form-control", type = "time" })
                                    @Html.ValidationMessageFor(model => model.AppointmentTime, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(model => model.ConsultationFees, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(model => model.ConsultationFees, new { @class = "form-control", type = "number", placeholder = "Enter consultation fees" })
                                @Html.ValidationMessageFor(model => model.ConsultationFees, "", new { @class = "text-danger" })
                            </div>

                            <div class="d-flex justify-content-between">
                                <a href="javascript:void(0);" id="backToManageExperts" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left me-1"></i> Back
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-1"></i> Save Doctor
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
