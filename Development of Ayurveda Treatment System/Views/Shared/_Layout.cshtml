<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Development_of_Ayurveda_Treatment_System</title>
    <!-- Favicons -->
    <link href="~/assets/img/Ayurgrow.ico" rel="icon">
    <!-- <link href="assets/img/apple-touch-icon.png" rel="apple-touch-icon"> -->
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">


    <!-- Vendor CSS Files -->
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet" />
    <link href="~/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet" />
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet" />

    <!-- Main CSS File -->
    <link href="~/assets/css/main.css" rel="stylesheet">
    <link href="~/assets/css/login.css" rel="stylesheet">
    <link href="~/assets/css/RegisterUser.css" rel="stylesheet">
    <link href="~/assets/css/adminDashboard.css" rel="stylesheet">
    <link href="~/assets/css/medicineManage.css" rel="stylesheet">
</head>
<body>
    <header id="header" class="header sticky-top">

        <div class="topbar d-flex align-items-center">
            <div class="container d-flex justify-content-center justify-content-md-between">
                <div class="contact-info d-flex align-items-center">
                    <i class="bi bi-envelope d-flex align-items-center"><a href="mailto:contact@ayurgrow.com">contact@ayurgrow.com</a></i>
                    <i class="bi bi-phone d-flex align-items-center ms-4"><span>+91 5589 5548 55</span></i>
                </div>
                <div class="social-links d-none d-md-flex align-items-center">
                    <a href="https://x.com/" class="twitter"><i class="bi bi-twitter-x"></i></a>
                    <a href="https://www.facebook.com/" class="facebook"><i class="bi bi-facebook"></i></a>
                    <a href="https://www.instagram.com/" class="instagram"><i class="bi bi-instagram"></i></a>
                    <a href="https://www.linkedin.com" class="linkedin"><i class="bi bi-linkedin"></i></a>
                </div>
            </div>
        </div><!-- End Top Bar -->

        <div class="branding d-flex align-items-center">

            <div class="container position-relative d-flex align-items-center justify-content-between">
                <a href="@Url.Action("Index", "Home")" class="logo d-flex align-items-center me-auto">
                    <h1 class="sitename">Ayurgrow</h1>
                </a>

                <nav id="navmenu" class="navmenu">
                    <ul>
                        <li><a href="@Url.Action("Index", "Home")" class="active">Home<br></a></li>
                        <li><a href="@Url.Action("Index", "Home")#about">About</a></li>
                        <li><a href="@Url.Action("Index", "Home")#services">Services</a></li>
                        <li><a href="@Url.Action("Index", "Home")#departments">Departments</a></li>
                        <li><a href="@Url.Action("Index", "Home")#doctors">Doctors</a></li>
                        <li class="dropdown">
                            <a href="#"><span>Core</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                            <ul>
                                <li><a asp-action="Login" asp-controller="Home">Medicine</a></li>
                                <li><a asp-action="Login" asp-controller="Home">Vendors</a></li>
                                <li><a asp-action="Login" asp-controller="Home">Course</a></li>
                                <li><a asp-action="Login" asp-controller="Home">E-Books</a></li>
                                <li><a asp-action="Login" asp-controller="Home">Billings</a></li>
                                <li><a asp-action="Login" asp-controller="Home">Our Experts</a></li>
                                <li><a asp-action="Login" asp-controller="Home">Sign in/Log in</a></li>
                                <li class="dropdown">
                                    <a href="#"><span>Support</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                                    <ul>
                                        <li><a href="@Url.Action("Index", "Home")#faq">FAQs</a></li>
                                        <li><a asp-action="Login" asp-controller="Home">Feedback</a></li>
                                        <li><a asp-action="Login" asp-controller="Home">Reports</a></li>
                                        <li><a asp-action="Privacy" asp-controller="Home">Policies</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </li>
                        <li><a href="#contact">Contact</a></li>
                    </ul>
                    <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
                </nav>
                <a class="cta-btn d-none d-sm-block" asp-action="Login" asp-controller="Home">Make an Appointment</a>
            </div>
        </div>
    </header>

    @RenderBody()
    @RenderSection("Scripts", required: false)

    <footer id="footer" class="footer light-background">

        <div class="container footer-top">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6 footer-about">
                    <a href="index.html" class="logo d-flex align-items-center">
                        <span class="sitename">Ayurgrow</span>
                    </a>
                    <div class="footer-contact pt-3">
                        <p>A108 New Delhi</p>
                        <p>Delhi, Delhi 110008</p>
                        <p class="mt-3"><strong>Phone:</strong> <span>+91 5589 5548 55</span></p>
                        <p><strong>Email:</strong> <span>info@ayurgrow.com</span></p>
                    </div>
                    <div class="social-links d-flex mt-4">
                        <a href="https://x.com/"><i class="bi bi-twitter-x"></i></a>
                        <a href="https://www.facebook.com/"><i class="bi bi-facebook"></i></a>
                        <a href="https://www.instagram.com/"><i class="bi bi-instagram"></i></a>
                        <a href="https://www.linkedin.com"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Useful Links</h4>
                    <ul>
                        <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li><a href="@Url.Action("Index", "Home")#about">About us</a></li>
                        <li><a href="@Url.Action("Index", "Home")#services">Services</a></li>
                        <li><a href="#">Terms of service</a></li>
                        <li><a asp-action="Privacy" asp-controller="Home">Privacy policy</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Our Services</h4>
                    <ul>
                        <li><a asp-action="Login" asp-controller="Home">Medicine</a></li>
                        <li><a asp-action="Login" asp-controller="Home">Course</a></li>
                        <li><a asp-action="Login" asp-controller="Home">Vendors</a></li>
                        <li><a asp-action="Login" asp-controller="Home">E-Books</a></li>
                        <li><a asp-action="Login" asp-controller="Home">Expert for Ayurveda</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Doctors & Department</h4>
                    <ul>
                        <li><a href="@Url.Action("Index", "Home")#departments">Departments</a></li>
                        <li><a href="@Url.Action("Index", "Home")#doctors">Doctors</a></li>
                        <li><a href="@Url.Action("Index", "Home")#faq">FAQs</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="container copyright text-center mt-4">
            <p>© <span>Copyright</span> <strong class="px-1 sitename">Ayurgrow</strong> <span>All Rights Reserved</span></p>
        </div>
    </footer>
    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Preloader -->
    <div id="preloader"></div>

    <!-- Vendor JS Files -->
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/php-email-form/validate.js"></script>
    <script src="~/assets/vendor/aos/aos.js"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>

    <!-- Main JS File -->
    <script src="~/assets/js/main.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
    
    <script src="~/assets/js/registerUser.js"></script>
    <script src="~/assets/js/login.js"></script>
    <script src="~/assets/js/userDashboard.js"></script>
    <script src="~/assets/js/adminDashboard.js"></script>
    

</body>
</html>
