@model Development_of_Ayurveda_Treatment_System.Models.Appointment

@{
    ViewData["Title"] = "Book Appointment";
}

<main class="main">
    <div class="container mt-5">
        <h2 class="mb-4 text-center"><i class="fas fa-calendar-check me-2"></i>Book Appointment</h2>

        <!-- Display message -->
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }

        <div id="appointmentMessage"></div>

        <div class="card shadow-sm border-0 rounded-4 p-4">
            <form id="appointmentForm" method="post">
                @Html.AntiForgeryToken()

                <!-- Hidden Fields -->
                <input type="hidden" asp-for="ID" value="@Model.ID ?? Guid.NewGuid().ToString()" />
                <input type="hidden" asp-for="DoctorId" value="@Model.DoctorId" />
                <input type="hidden" asp-for="UserId" value="@Model.UserId" />

                <!-- Doctor Info -->
                <div class="mb-3">
                    <label class="form-label">Doctor</label>
                    <input type="text" class="form-control" value="@Model.DoctorName" readonly />
                </div>

                <!-- Appointment Date -->
                <div class="mb-3">
                    <label asp-for="AppointmentDate" class="form-label">Appointment Date</label>
                    <input asp-for="AppointmentDate" type="date" class="form-control" required />
                </div>

                <!-- Appointment Time -->
                <div class="mb-3">
                    <label asp-for="AppointmentTime" class="form-label">Appointment Time</label>
                    <input asp-for="AppointmentTime" type="time" class="form-control" required />
                </div>

                <!-- Consultation Fee -->
                <div class="mb-3">
                    <label asp-for="ConsultationFee" class="form-label">Consultation Fee (₹)</label>
                    <input asp-for="ConsultationFee" class="form-control" readonly />
                </div>

                <div class="d-flex justify-content-between mt-3 gap-3">
                    <button type="submit" class="btn btn-success flex-grow-1">
                        <i class="fas fa-check-circle me-1"></i> Confirm Appointment
                    </button>               

                    <button type="button" id="cancelAppointmentBtn" class="btn btn-danger flex-grow-1">
                        <i class="fas fa-times-circle me-1"></i> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

<style>
    .card {
        margin-top: 20px;
    }
</style>
